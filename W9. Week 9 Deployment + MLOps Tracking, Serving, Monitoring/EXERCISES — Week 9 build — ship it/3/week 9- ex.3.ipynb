   "source": [
    "2. Baseline RandomForest vs tuned XGBoost via RandomizedSearchCV (AUC, CV=5). Report best params and\n",
    "mean ± std."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "a6b3c1a5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "RandomForest AUC: 1.0 ± 0.0\n"
     ]
    }
   ],
   "source": [
    "import pandas as pd\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.model_selection import StratifiedKFold, cross_val_score\n",
    "features[\"last_order_date\"] = pd.to_datetime(features[\"last_order_date\"])\n",
    "features[\"days_since_last_order\"] = (pd.Timestamp.today() - features[\"last_order_date\"]).dt.days\n",
    "X = features.drop([\"churned\", \"last_order_date\"], axis=1)  \n",
    "y = features[\"churned\"]\n",
    "X = pd.get_dummies(X, drop_first=True)\n",
    "cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "rf = RandomForestClassifier(random_state=42)\n",
    "rf_scores = cross_val_score(rf, X, y, cv=cv, scoring=\"roc_auc\")\n",
    "print(\"RandomForest AUC:\", rf_scores.mean(), \"±\", rf_scores.std())"
   ]
  },
